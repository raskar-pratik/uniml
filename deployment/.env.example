# UniML Environment Configuration
# Copy this file to ../.env and customize as needed.

# General
UNIML_APP_NAME=UniML
UNIML_APP_VERSION=1.0.0
UNIML_DEBUG=false

# Server
UNIML_HOST=0.0.0.0
UNIML_PORT=8000

# Upload Limits
UNIML_MAX_UPLOAD_SIZE_MB=500

# Logging
UNIML_LOG_LEVEL=INFO
UNIML_LOG_ROTATION=10 MB
UNIML_LOG_RETENTION=30 days
