version: "3.9"

services:
  {{ project_name }}:
    build: .
    container_name: {{ project_name }}
    ports:
      - "{{ port }}:{{ port }}"
    environment:
      - MODEL_PATH=model.onnx
      - HOST={{ host }}
      - PORT={{ port }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ port }}/health')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
