"""FastAPI inference server — generated by UniML.

This is the main application entry point. Run with:
    uvicorn main:app --host {{ host }} --port {{ port }}
"""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from predict import predict, ModelInput, ModelOutput
from config import settings

app = FastAPI(
    title="{{ project_name }}",
    description="ML inference server generated by UniML",
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/health")
async def health():
    """Health check endpoint."""
    return {"status": "healthy", "model": settings.MODEL_PATH}


@app.get("/info")
async def info():
    """Model information endpoint."""
    return {
        "project": "{{ project_name }}",
        "model_path": settings.MODEL_PATH,
        "host": settings.HOST,
        "port": settings.PORT,
        "generated_by": "UniML",
    }


@app.post("/predict", response_model=ModelOutput)
async def predict_endpoint(data: ModelInput):
    """Run inference on the provided input data."""
    result = predict(data)
    return result
