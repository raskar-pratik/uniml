"""Prediction module — generated by UniML.

Loads the ONNX model and provides the predict() function.
"""

from typing import List, Optional

import numpy as np
import onnxruntime as ort
from pydantic import BaseModel

from config import settings


# ── Load model once at startup ───────────────────────────────────
_session: Optional[ort.InferenceSession] = None


def _get_session() -> ort.InferenceSession:
    global _session
    if _session is None:
        _session = ort.InferenceSession(settings.MODEL_PATH)
    return _session


# ── Request / Response schemas ───────────────────────────────────

class ModelInput(BaseModel):
    """Input data for prediction."""
    data: List[List[float]]

    class Config:
        json_schema_extra = {
            "example": {
                "data": [[1.0, 2.0, 3.0, 4.0]]
            }
        }


class ModelOutput(BaseModel):
    """Prediction output."""
    predictions: List
    model_name: str = "{{ project_name }}"


# ── Predict function ────────────────────────────────────────────

def predict(input_data: ModelInput) -> ModelOutput:
    """Run inference using ONNX Runtime."""
    session = _get_session()

    input_name = session.get_inputs()[0].name
    input_array = np.array(input_data.data, dtype=np.float32)

    outputs = session.run(None, {input_name: input_array})

    # Convert numpy outputs to Python lists
    predictions = outputs[0].tolist()

    return ModelOutput(predictions=predictions)
